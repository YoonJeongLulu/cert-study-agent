# Required secrets. Never commit real values.
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_CHAT_ID=123456789
OPENAI_API_KEY=replace_with_openai_project_key

# Runtime
TZ=Asia/Seoul
SCHEDULE_START_HOUR=9
SCHEDULE_END_HOUR=22
# Optional ISO 8601 deadline, for example 2026-10-05T09:00:00+09:00
EXAM_AT=
CERT_COACH_DATABASE_PATH=/data/study.sqlite3

# Cost-conscious defaults
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=1600
MAX_QUESTIONS_PER_LESSON=2
LESSON_WEB_SEARCH=false
ALLOW_FALLBACK_QUESTIONS=false
